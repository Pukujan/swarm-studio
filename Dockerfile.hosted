# The hosted studio (docs/specs/13-hosted-studio.md): server/hosted.mjs, plain Node, no npm dependencies.
# The image holds no secrets; the model key comes from the env file at run time (deploy/README.md).
FROM node:24-slim
# zip packs the export bundle (engine/export.mjs); without it the export just has no .zip
RUN apt-get update && apt-get install -y --no-install-recommends zip && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY engine ./engine
COPY server ./server
COPY web ./web
COPY packs ./packs
COPY skills ./skills
COPY gameskills ./gameskills
COPY plugin.yaml ./
# the ARES web game, served at /studio/app/ares/ (web, plus the assets and data it loads)
COPY games/ares/web ./games/ares/web
COPY games/ares/assets ./games/ares/assets
COPY games/ares/data ./games/ares/data
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    SWARM_DATA_DIR=/data
RUN mkdir -p /data && chown -R node:node /data
USER node
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "server/hosted.mjs"]
