; ARES: a fast first-person arena shooter boss rush. Godot 4.
config_version=5

[application]

config/name="ARES"
config/description="Hermes's swift messenger storms the war god's arena."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"
Fx="*res://scripts/fx.gd"

[display]

window/dpi/allow_hidpi.web=false

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method.web="gl_compatibility"

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/size=4096
