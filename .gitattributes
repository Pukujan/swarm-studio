# Every checkout gets LF, on Windows too (core.autocrlf=true would otherwise turn text into CRLF).
# The tests read engine, web and Python source as text and match it line by line, and the vendored
# libraries are checked by their hash (tests/vendor.test.mjs), so CRLF fails them (issue #408).
* text=auto eol=lf

# binary: never converted, never diffed as text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.m4a binary
*.wav binary
*.ogg binary
*.mp4 binary
*.webm binary
*.glb binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
